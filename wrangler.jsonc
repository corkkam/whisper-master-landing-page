{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Workers deploy of the Next.js app, built by @opennextjs/cloudflare.
  // Build and deploy: `pnpm cf:deploy`. Secrets are set with `wrangler secret`, never here.
  "name": "whisper-master-landing-page",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "whisper-master-landing-page"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    { "pattern": "typing.sucks", "custom_domain": true },
    { "pattern": "www.typing.sucks", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
