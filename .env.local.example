# Copy to `.env.local` and fill in. (.env.local is gitignored.)

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys.
# Two instances, ONE userbase per instance:
#   • Development instance → test keys (pk_test_ / sk_test_)  → Local + Preview
#   • Production instance  → live keys (pk_live_ / sk_live_)  → Production
# The Production instance serves BOTH beta and stable users — the only
# difference is the `betaAccess` flag on publicMetadata (set on waitlist join;
# see lib/clerk/beta.ts). Use test keys here for local dev.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# After OAuth (Google) sign-in/sign-up, Clerk redirects here.
# The ?join=details param tells JoinContext to auto-open the details modal.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/?join=details
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/?join=details

# ── Supabase (database only — auth is handled by Clerk) ──────────────────────
# LOCAL DEV (recommended): run `supabase start` and use the local stack.
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
#   SUPABASE_SERVICE_ROLE_KEY=<printed by `supabase start` / `supabase status`>
# CLOUD: Project Settings → API for the hosted values below.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-only — NEVER prefix with NEXT_PUBLIC. Bypasses RLS (service role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Which Postgres schema to use (one instance, separated per environment):
#   public → Production + local dev   |   dev → Preview deploys
# Defaults to "public" when unset.
SUPABASE_DB_SCHEMA=public

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Google Analytics 4 (optional) ─────────────────────────────────────────────
# Measurement ID from https://analytics.google.com → Admin → Data streams.
# Leave UNSET locally: with no ID there is no tag, no cookie, and no consent
# banner (lib/analytics.ts). Set it in Vercel for Production only if you'd
# rather previews stay out of your reporting.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Cloudflare Turnstile (bot check) ─────────────────────────────────────────
# REQUIRED IN PRODUCTION. `submitWaitlist` verifies this token server-side; it
# is what stops scripted multi-account referral farming (Clerk proves the email
# is real, but not that a human is driving).
#
# Leave both unset locally — with no secret and NODE_ENV!=production the check
# is skipped. In production a missing secret FAILS CLOSED (joins are rejected).
# To ship before Turnstile is set up, set TURNSTILE_DISABLED=true so that
# "no bot protection" is a deliberate, greppable decision rather than a silent
# misconfiguration — then remove it once the keys are in.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key
# TURNSTILE_DISABLED=true

# ── Payment (add when integrating Stripe / Polar / etc.) ─────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
