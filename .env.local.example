# Copy to `.env.local` and fill in. (.env.local is gitignored.)

# ── Clerk (auth) ──────────────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# After OAuth (Google) sign-in/sign-up, Clerk redirects here.
# The ?join=details param tells JoinContext to auto-open the details modal.
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/?join=details
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/?join=details

# ── Supabase (database only — auth is handled by Clerk) ──────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Server-only — NEVER prefix with NEXT_PUBLIC. Bypasses RLS (service role).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Cloudflare Turnstile (optional bot check) ─────────────────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
# TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# ── Payment (add when integrating Stripe / Polar / etc.) ─────────────────────
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
