# Copy to `.env.local` and fill in. (.env.local is gitignored.)

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — NEVER prefix with NEXT_PUBLIC. Used for admin reads (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the app is served (used to build the OAuth redirect). Local dev:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (bot check at signup) → dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
